# Tool images for the Helm chart checks (deploy/helm/scripts/validate.sh) and the kind smoke install
# (scripts/helm-smoke.sh). Bash-sourceable KEY=value lines; every image is name:tag@sha256:<multi-arch index digest>.
# Versions: latest release at least two weeks old as of 2026-11-05 (published on or before 2026-10-22).

# alpine/helm 4.3.1 (Helm v4.3.1, 2026-10-15): helm lint / template
HELM_IMAGE=alpine/helm:4.3.1@sha256:e3f8d5c462d75470fbb1fce79ad5c20063657096d1f98c0fcea869e2600e2e5e
# helm-unittest v1.2.1 (2026-10-03) bundled with Helm 4.3.0 (newest Helm 4 tag of the image)
HELM_UNITTEST_IMAGE=helmunittest/helm-unittest:4.3.0-1.2.1@sha256:28ea86c3e0b07f501f0c2e9c08b9f41e240f4a4b571cb5106b36cf0f0607e989
# kubeconform v0.8.0 (2026-06-04): schema validation of rendered manifests
KUBECONFORM_IMAGE=ghcr.io/yannh/kubeconform:v0.8.0@sha256:faffaf43f95aa6425306e1ab8d6fcad72acb9049158f38e574c085ea1ec0f64e
# kind v0.33.0 (installed via Homebrew); Kubernetes v1.37.0 node image (released 2026-08-26), digest from the kind v0.33.0 release notes
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Gatling (used in loadtest/pom.xml, Task 6): gatling-charts-highcharts 3.16.0 (2026-09-29), gatling-maven-plugin 4.21.12 (2026-09-07)

# datreeio/CRDs-catalog commit (pinned; schemas for ServiceMonitor and PodMonitoring in kubeconform). Route is not in the
# catalog: its schema is vendored in deploy/helm/schemas/route.openshift.io/route_v1.json.
CRD_CATALOG_SHA=6ab3493622cd387923a2d0da5234f53e80e1bd28
