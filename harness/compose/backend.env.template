# Non-secret backend configuration of the local E2E stack (environment-variable form, see docs/operations.md).
# GenSecrets.java copies this file into harness/build/e2e/secrets.env and appends the per-run secrets
# (sender key hashes, grant/HMAC secrets, device-token signing key pair, database password) the *REF keys point to.
# Never put a secret here: this file is committed.

# Database (password generated per run)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/reliablepush
SPRING_DATASOURCE_USERNAME=reliablepush

# Fast clock: 1 product "minute" = 1 s (accepted only with the e2e/demo profile)
RELIABLEPUSH_TESTING_MINUTEDURATION=1s

# Device-token signing key (PEMs generated per run into RP_DEVICE_KEY_E2E / RP_DEVICE_PUB_E2E)
RELIABLEPUSH_DEVICETOKEN_SIGNINGKEYS_0_KID=e2e
RELIABLEPUSH_DEVICETOKEN_SIGNINGKEYS_0_PRIVATEKEYPEMREF=env:RP_DEVICE_KEY_E2E
RELIABLEPUSH_DEVICETOKEN_SIGNINGKEYS_0_PUBLICKEYPEMREF=env:RP_DEVICE_PUB_E2E
RELIABLEPUSH_DEVICETOKEN_CURRENTKID=e2e

# App shop: the default app of the scenarios
RELIABLEPUSH_APPS_SHOP_IDENTITY_TYPE=signed-grant
RELIABLEPUSH_APPS_SHOP_IDENTITY_ISSUER=reliable-push-harness
RELIABLEPUSH_APPS_SHOP_IDENTITY_AUDIENCE=shop
RELIABLEPUSH_APPS_SHOP_IDENTITY_GRANTSECRETREF=env:RP_SHOP_GRANT_SECRET
RELIABLEPUSH_APPS_SHOP_FALLBACK_URL=http://harness:8090/hooks/shop
RELIABLEPUSH_APPS_SHOP_FALLBACK_HMACSECRETREF=env:RP_SHOP_HOOK_SECRET
RELIABLEPUSH_APPS_SHOP_DEFAULTTIMEOUTMINUTES=5

# App news: short device-token validity (token refresh scenario)
RELIABLEPUSH_APPS_NEWS_IDENTITY_TYPE=signed-grant
RELIABLEPUSH_APPS_NEWS_IDENTITY_ISSUER=reliable-push-harness
RELIABLEPUSH_APPS_NEWS_IDENTITY_AUDIENCE=news
RELIABLEPUSH_APPS_NEWS_IDENTITY_GRANTSECRETREF=env:RP_NEWS_GRANT_SECRET
RELIABLEPUSH_APPS_NEWS_FALLBACK_URL=http://harness:8090/hooks/news
RELIABLEPUSH_APPS_NEWS_FALLBACK_HMACSECRETREF=env:RP_NEWS_HOOK_SECRET
RELIABLEPUSH_APPS_NEWS_DEFAULTTIMEOUTMINUTES=5
RELIABLEPUSH_APPS_NEWS_DEVICETOKENVALIDITY=PT20S

# App limited: tiny device rate limit (rate-limit scenario)
RELIABLEPUSH_APPS_LIMITED_IDENTITY_TYPE=signed-grant
RELIABLEPUSH_APPS_LIMITED_IDENTITY_ISSUER=reliable-push-harness
RELIABLEPUSH_APPS_LIMITED_IDENTITY_AUDIENCE=limited
RELIABLEPUSH_APPS_LIMITED_IDENTITY_GRANTSECRETREF=env:RP_LIMITED_GRANT_SECRET
RELIABLEPUSH_APPS_LIMITED_FALLBACK_URL=http://harness:8090/hooks/limited
RELIABLEPUSH_APPS_LIMITED_FALLBACK_HMACSECRETREF=env:RP_LIMITED_HOOK_SECRET
RELIABLEPUSH_APPS_LIMITED_DEFAULTTIMEOUTMINUTES=5
RELIABLEPUSH_APPS_LIMITED_RATELIMITS_DEVICEPERMINUTE=2
