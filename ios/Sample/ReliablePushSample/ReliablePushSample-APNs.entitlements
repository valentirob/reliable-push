<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Real APNs on the Simulator (RP_APNS=1): needs a team with Push Notifications, see docs/testing.md. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the Notification Service Extension: the SDK's state, queue and (as Keychain access group) the device token. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(RP_APP_GROUP)</string>
	</array>
</dict>
</plist>
