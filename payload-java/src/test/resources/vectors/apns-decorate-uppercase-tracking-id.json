{
  "name": "apns-decorate-uppercase-tracking-id",
  "description": "an upper-case tracking id is embedded lower-cased",
  "operation": "apns.decorate",
  "input": {
    "trackingId": "6F1C2B9E-5D1A-4C55-9A38-0C1F3A7D9E11",
    "apns": {
      "aps": {
        "alert": "Hello"
      }
    }
  },
  "expect": {
    "output": {
      "aps": {
        "alert": "Hello",
        "mutable-content": 1
      },
      "rp_tid": "6f1c2b9e-5d1a-4c55-9a38-0c1f3a7d9e11"
    }
  }
}
